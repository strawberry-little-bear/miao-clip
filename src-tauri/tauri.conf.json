{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiaoClip",
  "version": "0.1.0",
  "identifier": "com.strawberrylittlebear.miaoclip",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "妙夹 · MiaoClip",
        "url": "index.html?build=5",
        "width": 920,
        "height": 640,
        "visible": true,
        "center": true,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 520
      },
      {
        "label": "toast",
        "title": "妙夹提示",
        "url": "toast.html?build=3",
        "width": 390,
        "height": 108,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "shadow": false,
        "center": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
